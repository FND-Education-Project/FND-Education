{
  "version": 1,
  "status": "reviewed-conservative-policy",
  "purpose": "Machine-readable policy for page-level Schema.org generation. It classifies existing generated page kinds without adding schema metadata to canonical Markdown.",
  "principles": [
    "WebPage is the default substantive page type.",
    "CollectionPage is used only for pages whose primary function is to organize a real collection of child pages or resources.",
    "MedicalWebPage is not used without an explicit authority/review signal.",
    "Article is not used merely because a page is long or informative.",
    "Breadcrumb schema is deferred.",
    "Page-specific medical entities are not inferred from body prose.",
    "Git commit dates are not medical review dates."
  ],
