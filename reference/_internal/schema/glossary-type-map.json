  "version": 1,
  "status": "reviewed-internal-map",
  "purpose": "Stable semantic classification for the FND Education Project glossary. The public glossary remains a DefinedTermSet; semantic_type describes what a term refers to and must not be emitted as an additional Schema.org @type for the DefinedTerm itself.",
  "policy": {
    "public_schema_type": "DefinedTerm",
    "semantic_type_visibility": "internal-only",
    "term_code_visibility": "public-schema",
    "markdown_metadata_required": false,
    "on_unmapped_term": "fail-build",
    "on_stale_map_entry": "fail-build"
  },
  "categories": {
    "therapy-rehabilitation": "Therapy, rehabilitation method, or treatment-support technique.",
    "communication-access": "Communication-access method or aid.",
    "neuroscience-research-concept": "Neuroscience, cognitive-science, or research concept.",
    "clinical-framework-or-concept": "General clinical framework, reasoning concept, or descriptive clinical concept.",
    "positive-diagnostic-sign": "Positive examination sign or clinically interpreted positive feature.",
    "diagnostic-test-or-assessment": "Diagnostic test, recording method, or structured assessment technique.",
    "fnd-condition-or-presentation": "FND diagnosis, presentation, symptom subtype, or current seizure label.",
    "other-condition-or-diagnosis": "Non-FND diagnosis or independently defined coexisting condition.",
    "symptom-or-clinical-feature": "Symptom, clinical feature, physical complication, or descriptive health term.",
    "terminology-or-classification": "Historical, classificatory, contested, or search terminology rather than a clinical entity type.",
    "medication-class": "Prescription medication class.",
    "safety-concept-or-presentation": "Safety concept or presentation requiring cautious medical assessment.",
    "community-or-project-language": "Community metaphor or project-preferred plain-language concept."
  },
